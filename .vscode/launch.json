{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API: Uvicorn (reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Criar admin",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/create_admin.py",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        },
        {
            "name": "Testes (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests", "-v"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}
