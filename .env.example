# =============================================================================
# Ticket System - configuração
# Copie para .env e ajuste os valores:   cp .env.example .env
# Nunca faça commit do arquivo .env
# =============================================================================

# --- App ---
APP_NAME=Ticket System
APP_URL=http://localhost:8000
LOG_LEVEL=INFO
# production = o app não sobe com SECRET_KEY fraca/padrão
APP_ENV=development

# --- Segurança ---
# Gere um valor aleatório:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Banco de dados ---
# SQLite (desenvolvimento). Caminhos relativos são resolvidos a partir da pasta do projeto.
DATABASE_URL=sqlite:///./tickets.db
# PostgreSQL (produção, ex.: Neon) - o driver psycopg 3 já vem em requirements.txt; postgres:// e postgresql:// funcionam
# DATABASE_URL=postgresql://tickets:senha@localhost:5432/tickets

# Quantos proxies de confiança ficam na frente do app (0 = nenhum; Vercel e Render: 1). Define qual entrada do
# X-Forwarded-For (contada da direita) é o cliente no limite de tentativas de login e na auditoria.
TRUSTED_PROXY_HOPS=0

# --- CORS (separado por vírgula) ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Uploads ---
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.doc,.docx,.xls,.xlsx,.zip,.csv

# --- E-mail (SMTP) ---
# Com SMTP_HOST vazio os e-mails são apenas registrados no log (modo desenvolvimento).
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@ticketsystem.local
EMAIL_FROM_NAME=Ticket System

# --- Monitor de SLA ---
SLA_MONITOR_ENABLED=true
SLA_CHECK_INTERVAL_MINUTES=15
# Fração do prazo consumida que dispara o alerta ao responsável (0.75 = 75%)
SLA_WARNING_THRESHOLD=0.75
